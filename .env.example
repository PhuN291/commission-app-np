# Postgres connection string (bắt buộc). Local ví dụ:
#   postgresql://<user>@localhost:5432/np_commission
# Production (Vercel): dùng Neon POOLED endpoint (host có "-pooler"):
#   postgresql://<user>:<pass>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=""

# (tuỳ chọn) Đặt "1" để chạy seed idempotent lúc server khởi động. Mặc định:
# chỉ seed ở local dev; production KHÔNG seed on boot (chạy `npm run seed` một lần).
# SEED_ON_BOOT=

# PORT do host tự set (Vercel/Railway). Local mặc định 3001 nếu không đặt.
# PORT=
